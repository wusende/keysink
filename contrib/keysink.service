[Unit]
Description=keysink vault gateway
Documentation=file:/usr/local/share/doc/keysink/README.md
After=network-online.target
Wants=network-online.target
# vault 未初始化时不启动（deploy.sh 里交互 init；避免空转重启）
ConditionPathExists=/var/lib/keysink/vault.key

[Service]
Type=simple
User=keysink
Group=keysink
ExecStart=/usr/local/bin/keysink serve --listen 127.0.0.1:8787
Environment=KEYSINK_VAULT_HOME=/var/lib/keysink
Environment=RUST_LOG=info
StateDirectory=keysink
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=2
# 优雅停机最多等 10s：长 SSE 连接不会无限拖住 stop，超时由 SIGKILL 兜底
TimeoutStopSec=10

# 硬化：不产生 core dump、不提权、home 只读
LimitCORE=0
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/keysink
# 如果开启审计，把审计目录也放行：
# ReadWritePaths=/var/log/keysink

[Install]
WantedBy=multi-user.target
