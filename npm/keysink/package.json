{
  "name": "keysink",
  "version": "0.2.3",
  "description": "One-way local gateway for AI agents: real API keys (Anthropic, OpenAI, Gemini) never enter the agent's environment. Agents get revocable virtual keys; a prompt-injected agent can dump its env and get nothing.",
  "license": "MIT",
  "author": "wusende",
  "homepage": "https://github.com/wusende/keysink#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wusende/keysink.git"
  },
  "bugs": {
    "url": "https://github.com/wusende/keysink/issues"
  },
  "keywords": [
    "api-keys",
    "secrets",
    "secrets-management",
    "prompt-injection",
    "llm",
    "llm-proxy",
    "proxy",
    "gateway",
    "cli",
    "claude-code",
    "anthropic",
    "openai",
    "gemini",
    "mcp",
    "ai-agents",
    "api-key-rotation",
    "dotenv",
    "security"
  ],
  "bin": {
    "keysink": "bin/keysink.js"
  },
  "files": [
    "bin/keysink.js",
    "vendor/"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
